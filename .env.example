# =============================================================================
# netmon - Configuración (copia esto a /etc/netmon/netmon.env y ajustá)
# Todas las variables llevan prefijo NETMON_. Las leen los servicios systemd
# (EnvironmentFile=) y la librería pydantic-settings.
#
# IMPORTANTE: los comentarios van SIEMPRE en su propia línea, nunca a la
# derecha de un valor. systemd (EnvironmentFile=) NO recorta los comentarios
# en línea: se los pasaría al programa como parte del valor y rompería el
# parseo (ej. NETMON_PING_COUNT="5   # ..." no es un número válido).
# =============================================================================

# --- Base de datos -----------------------------------------------------------
NETMON_DB_DSN=postgresql://netmon:CAMBIAME@127.0.0.1:5432/netmon

# --- ntopng (motor de captura, corre en este mismo servidor) -----------------
# Si ntopng corre con --disable-login=1 (default del instalador, escucha solo
# en loopback) dejá token/usuario vacíos. Si activaste login, generá un token
# en ntopng (Settings -> Users -> API Token) o usá usuario/clave.
NETMON_NTOPNG_URL=http://127.0.0.1:3000
NETMON_NTOPNG_TOKEN=
NETMON_NTOPNG_USER=
NETMON_NTOPNG_PASS=
NETMON_NTOPNG_IFID=0

# --- Red local ----------------------------------------------------------------
# Subredes internas separadas por coma. DEBE coincidir con --local-networks de
# ntopng. Incluí TODAS las VLANs de usuarios/servidores.
NETMON_LOCAL_NETWORKS=192.168.10.0/24,192.168.20.0/24,192.168.30.0/24

# --- Targets de monitoreo de enlace --------------------------------------------
# GATEWAY_IP: IP interna del WatchGuard (gateway de la VLAN de usuarios)
# WAN_PROBES: sondas de internet, separadas por coma
# INTERNAL_DNS_IP: IP del DNS interno del dominio (normalmente el DC)
NETMON_GATEWAY_IP=192.168.10.1
NETMON_WAN_PROBES=8.8.8.8,1.1.1.1
NETMON_INTERNAL_DNS_IP=192.168.10.5

# --- Interfaz de captura (la que va al puerto SPAN, sin IP) --------------------
NETMON_CAPTURE_IFACE=eth1

# --- Web / autenticación --------------------------------------------------------
# ADMIN_PASSWORD: clave de administrador del dashboard (login del navegador)
# KIOSK_TOKEN: token de solo lectura para la pantalla kiosco (/kiosk?token=...)
# SECRET_KEY: clave para firmar cookies de sesión (string aleatorio largo)
NETMON_LISTEN_HOST=0.0.0.0
NETMON_LISTEN_PORT=8080
NETMON_ADMIN_PASSWORD=CAMBIAME
NETMON_KIOSK_TOKEN=CAMBIAME_TOKEN_LARGO
NETMON_SECRET_KEY=CAMBIAME_SECRETO_ALEATORIO

# --- Intervalos y umbrales -------------------------------------------------------
# COLLECT_INTERVAL: seg. entre muestras persistidas
# LIVE_INTERVAL: seg. entre pushes WebSocket (hosts/estado)
# RT_INTERVAL: seg. entre muestras del gráfico realtime
# PING_INTERVAL: seg. entre rondas de ping
# PING_COUNT: pings por ronda por target
# LAT_WARN_MS / LOSS_WARN_PCT: umbrales de degradación (latencia / pérdida)
# DEGRADED_MINUTES: minutos sostenidos para alertar degradación
NETMON_COLLECT_INTERVAL=60
NETMON_LIVE_INTERVAL=5
NETMON_RT_INTERVAL=2
NETMON_PING_INTERVAL=10
NETMON_PING_COUNT=5
NETMON_LAT_WARN_MS=100
NETMON_LOSS_WARN_PCT=5
NETMON_DEGRADED_MINUTES=5

# --- Retención (tiers estilo RRD) ---------------------------------------------------
# RETENTION_MIN_HOURS: detalle por minuto (rangos 1 h / 24 h)
# RETENTION_5MIN_DAYS: tier 5 minutos (rango 7 días)
# RETENTION_HOUR_DAYS: rollup horario (rango 30 días y reportes)
NETMON_RETENTION_MIN_HOURS=48
NETMON_RETENTION_5MIN_DAYS=14
NETMON_RETENTION_HOUR_DAYS=90
NETMON_PING_RETENTION_DAYS=60

# --- Integración AD / Windows (opcional, dejar vacío para desactivar) --------------
# Host con WinRM habilitado (normalmente un DC). Ver docs/04-integracion-ad.md
# AD_WINRM_SCHEME: http (5985) o https (5986, recomendado)
# AD_DHCP_SERVER: FQDN del server DHCP; vacío = el mismo WinRM host
# USER_MAP_TTL_HOURS: cuánto vale un mapeo IP->usuario
NETMON_AD_WINRM_HOST=
NETMON_AD_WINRM_USER=DOMINIO\svc-netmon
NETMON_AD_WINRM_PASS=
NETMON_AD_WINRM_SCHEME=http
NETMON_AD_DHCP_SERVER=
NETMON_AD_POLL_SECONDS=300
NETMON_USER_MAP_TTL_HOURS=10

# --- Alertas por mail (opcional) -----------------------------------------------------
NETMON_SMTP_HOST=
NETMON_SMTP_PORT=25
NETMON_SMTP_TLS=false
NETMON_SMTP_USER=
NETMON_SMTP_PASS=
NETMON_SMTP_FROM=netmon@empresa.local
NETMON_SMTP_TO=sistemas@empresa.local

# --- Webhook de alertas (opcional; POST JSON genérico p/ Telegram/Teams via relay) ---
NETMON_WEBHOOK_URL=

# --- Varios ------------------------------------------------------------------------
NETMON_OUI_CSV=/opt/netmon/data/oui.csv
NETMON_BLOCKLIST_PATH=/opt/netmon/data/firehol_level1.netset
NETMON_GEOIP_MMDB=/opt/netmon/data/dbip-country-lite.mmdb
NETMON_REPORTS_DIR=/opt/netmon/reports
NETMON_FRONTEND_DIR=/opt/netmon/frontend
