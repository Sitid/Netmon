        "label": "Evento AD",
        "type": "custom",
        "query": "Todos : *, Login fallido (4625) : data.win.system.eventID:4625, Bloqueo (4740) : data.win.system.eventID:4740, Kerberos (4771) : data.win.system.eventID:4771, Cambios grupos admin : data.win.system.eventID:(4728 OR 4732 OR 4756 OR 4729 OR 4733 OR 4757)",
