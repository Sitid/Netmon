<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<!-- Suricata: elevar firmas de reputación (listas negras) para que entren al
     triage accionable (nivel >=5). El motor de reglas usa el campo sin el
     prefijo 'data.' (ver 86601 en 0475-suricata_rules.xml). -->
<group name="suricata,ids,attack,">

  <rule id="100100" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature">Spamhaus</field>
    <description>Suricata: tráfico con IP en lista negra Spamhaus - $(alert.signature)</description>
    <group>attack,reputation,pci_dss_11.4,</group>
  </rule>

  <rule id="100101" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature">Dshield</field>
    <description>Suricata: tráfico con IP en lista negra Dshield - $(alert.signature)</description>
    <group>attack,reputation,pci_dss_11.4,</group>
  </rule>

</group>
