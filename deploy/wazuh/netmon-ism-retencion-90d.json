{
  "policy": {
    "description": "netmon SOC: borra indices de alertas/archives a los 90 dias",
    "default_state": "hot",
    "ism_template": [
      { "index_patterns": ["wazuh-alerts-4.x-*", "wazuh-archives-4.x-*"], "priority": 100 }
    ],
    "states": [
      { "name": "hot", "actions": [],
        "transitions": [ { "state_name": "delete", "conditions": { "min_index_age": "90d" } } ] },
      { "name": "delete", "actions": [ { "delete": {} } ], "transitions": [] }
    ]
  }
}
